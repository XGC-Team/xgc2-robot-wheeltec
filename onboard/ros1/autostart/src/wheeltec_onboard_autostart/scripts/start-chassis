#!/usr/bin/env bash
set -euo pipefail

ROS_DISTRO="${ROS_DISTRO:-melodic}"
ROS_PREFIX="/opt/ros/${ROS_DISTRO}"
# shellcheck disable=SC1090,SC1091
source "${ROS_PREFIX}/setup.bash"

export ROS_MASTER_URI="${ROS_MASTER_URI:-http://127.0.0.1:11311}"
export ROS_IP="${ROS_IP:-127.0.0.1}"
export ROS_HOSTNAME="${ROS_HOSTNAME:-${ROS_IP}}"

HERE="$(cd "$(dirname "$0")" && pwd)"
"${HERE}/wait-roscore"

WAIT="${ROS_PREFIX}/lib/wheeltec_onboard_autostart/wait-device"
"${WAIT}" /dev/wheeltec_controller --timeout "${CONTROLLER_WAIT_TIMEOUT:-60}"

: "${XGC2_CHASSIS_ROBOT_ID:?site must supply its exact robot id}"
exec roslaunch --wait wheeltec_onboard_autostart chassis.launch \
  robot_id:="${XGC2_CHASSIS_ROBOT_ID}" \
  hold_port:="${XGC2_CHASSIS_HOLD_PORT:-19530}" \
  hold_key_file:="${XGC2_CHASSIS_HOLD_KEY_FILE:-/etc/xgc2/chassis-hold.key}" \
  hold_boot_held:="${XGC2_CHASSIS_HOLD_BOOT_HELD:-false}" \
  hold_required:="${XGC2_CHASSIS_HOLD_REQUIRED:-true}"
