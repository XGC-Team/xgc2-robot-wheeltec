#!/usr/bin/env bash
set -euo pipefail

ROS_DISTRO="${ROS_DISTRO:-melodic}"
ROS_PREFIX="/opt/ros/${ROS_DISTRO}"
# shellcheck disable=SC1090,SC1091
source "${ROS_PREFIX}/setup.bash"

export ROS_MASTER_URI="${ROS_MASTER_URI:-http://127.0.0.1:11311}"
export ROS_IP="${ROS_IP:-127.0.0.1}"
export ROS_HOSTNAME="${ROS_HOSTNAME:-${ROS_IP}}"

wait_topic() {
  local topic="$1"
  local timeout="${2:-90}"
  local deadline=$((SECONDS + timeout))
  while [[ ${SECONDS} -lt ${deadline} ]]; do
    if rostopic list 2>/dev/null | grep -qx "${topic}"; then
      return 0
    fi
    sleep 0.2
  done
  echo "topic did not appear: ${topic}" >&2
  return 1
}

HERE="$(cd "$(dirname "$0")" && pwd)"
"${HERE}/wait-roscore"

stagger="${SWARM_STAGGER_SEC:-6}"
echo "xgc2 wheeltec communication: stagger ${stagger}s after roscore"
sleep "${stagger}"

wait_topic "${CHASSIS_IMU_TOPIC:-/imu}" "${CHASSIS_IMU_WAIT_TIMEOUT:-90}"

CONFIG="${SWARM_ROS_BRIDGE_CONFIG:-/etc/xgc2/wheeltec/ros_topics.yaml}"
if [[ ! -f "${CONFIG}" ]]; then
  echo "missing ${CONFIG}; run Wheeltec · configure network" >&2
  exit 1
fi

exec roslaunch --wait wheeltec_onboard_autostart swarm.launch "config_file:=${CONFIG}"
