# Site identity. Copy to /etc/xgc2/wheeltec/onboard.env if missing.
# systemd units load it via EnvironmentFile; start-* scripts still have
# last-resort defaults if the file is missing.
#
# Enable chassis at boot; it Wants standalone roscore. Other units stay
# install-only. Never let roslaunch create its own master.

ROS_DISTRO=melodic
ROS_MASTER_URI=http://127.0.0.1:11311
ROS_IP=127.0.0.1
HOME=/home/wheeltec
ROSCORE_SETTLE_SEC=1
ROSCORE_WAIT_TIMEOUT=60
SWARM_STAGGER_SEC=6
SWARM_ROS_BRIDGE_CONFIG=/etc/xgc2/wheeltec/ros_topics.yaml
